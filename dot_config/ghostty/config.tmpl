font-family = JetBrainsMono Nerd Font Mono
font-size = {{ if eq .chezmoi.os "darwin" }}16{{ else }}12{{ end }}
theme = Gruvbox Material Dark
{{- if eq .chezmoi.os "darwin" }}

# Quake-style drop-down terminal. `global:` works even when Ghostty isn't
# focused, but needs Ghostty granted Accessibility access (System Settings →
# Privacy & Security → Accessibility). Overrides macOS's cmd+` window cycling.
# Ghostty.app must be running (cmux shares this file but has no quick terminal).
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.1
quick-terminal-autohide = true
# Start windowless and stay running, so the hotkey stays armed (add Ghostty to
# Login Items to arm it from boot).
initial-window = false
quit-after-last-window-closed = false
{{- end }}
